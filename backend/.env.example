# Point this to the extracted folder containing train/ and student_test/.
# Example: /Users/you/PathSnap/Student folder
PATHSNAP_DATA_ROOT="./data/Student folder"

# Development uses student_test. For the final demo, point this at the authorised
# evaluator partition folder made available by the organisers.
PATHSNAP_PARTITION=student_test

# Person 1 integration: directory containing <trip_id>.csv or <trip_id>.parquet
# Required columns: obs_index, arc_id, distance_m, fraction
# Extra Person 1 feature columns are preserved for Person 2.
PATHSNAP_CANDIDATE_DIR=

# Person 2 integration. Leave model mode as distance_fallback only for local smoke tests.
# To use a binary candidate classifier: PATHSNAP_MODEL_MODE=binary
# To use an arc-id multiclass classifier: PATHSNAP_MODEL_MODE=arc_multiclass
PATHSNAP_MODEL_MODE=distance_fallback
PATHSNAP_MODEL_PATH=
PATHSNAP_MODEL_FEATURES=
PATHSNAP_POSITIVE_CLASS=1
PATHSNAP_ALLOW_DEV_FALLBACK=true

PATHSNAP_CANDIDATE_RADIUS_M=100
PATHSNAP_MAX_CANDIDATES=8
PATHSNAP_EMISSION_SIGMA_M=25
PATHSNAP_TRANSITION_SIGMA_BASE_M=30
PATHSNAP_TRANSITION_SIGMA_FRACTION=0.5
PATHSNAP_MISSING_STATE_PENALTY=6
PATHSNAP_UNREACHABLE_PENALTY=12
PATHSNAP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
