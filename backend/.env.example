# Defaults work from any working directory using the root run_backend.sh.
# Optional overrides: export these in your shell before starting the backend.
# Paths with spaces must be quoted.
# PATHSNAP_DATA_ROOT="/absolute/path/to/Student folder"
PATHSNAP_PARTITION=student_test
# PATHSNAP_CANDIDATE_DIR="/absolute/path/to/prepared_data/student_test"
# PATHSNAP_MODEL_PATH="/absolute/path/to/artifacts/model"
PATHSNAP_MODEL_MODE=bundle
PATHSNAP_ALLOW_DEV_FALLBACK=false
PATHSNAP_ENV=production
PATHSNAP_TRANSITION_SIGMA_BASE_M=30
PATHSNAP_TRANSITION_SIGMA_FRACTION=0.5
PATHSNAP_MISSING_STATE_PENALTY=6
PATHSNAP_UNREACHABLE_PENALTY=12
PATHSNAP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
