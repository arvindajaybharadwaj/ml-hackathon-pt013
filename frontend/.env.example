# Development/preview proxy target. On the UI laptop, replace 127.0.0.1
# with the backend laptop's LAN IP and restart Vite.
VITE_BACKEND_TARGET=http://127.0.0.1:8000
# Optional direct API base URL for a separately hosted static build.
# This is baked into the frontend at build time and requires backend CORS setup.
# VITE_API_URL=http://BACKEND_LAPTOP_IP:8000
